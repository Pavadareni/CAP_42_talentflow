prefix=/d/a/cbcbox/cbcbox/cbc_dist
#prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=/d/a/cbcbox/cbcbox/cbc_dist/lib
includedir=${prefix}/include/coin-or

Name: Clp
Description: COIN-OR Linear Programming Solver
URL: https://github.com/coin-or/Clp
Version: devel
Cflags: -I${includedir}
Libs: -L${libdir} -lClp
Requires.private: coinutils 
