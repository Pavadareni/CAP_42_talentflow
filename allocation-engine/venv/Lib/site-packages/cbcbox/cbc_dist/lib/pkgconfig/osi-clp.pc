prefix=/d/a/cbcbox/cbcbox/cbc_dist
#prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=/d/a/cbcbox/cbcbox/cbc_dist/lib
includedir=${prefix}/include/coin-or

Name: OsiClp
Description: COIN-OR Open Solver Interface for CLP
URL: https://github.com/coin-or/Clp
Version: devel
Cflags: -I${includedir}
Libs: -L${libdir} -lOsiClp
Requires.private: osi  clp
#Libs: -L${libdir} -lOsiClp  
#Requires: osi  clp
