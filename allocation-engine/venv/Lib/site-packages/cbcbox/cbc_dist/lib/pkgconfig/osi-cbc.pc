prefix=/d/a/cbcbox/cbcbox/cbc_dist
#prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=/d/a/cbcbox/cbcbox/cbc_dist/lib
includedir=${prefix}/include/coin

Name: OsiCbc
Description: COIN-OR Open Solver Interface for CBC
URL: https://github.com/coin-or/Cbc
Version: devel
Cflags: -I${includedir}
Libs: -L${libdir} -lOsiCbc
Requires.private: cbc osi-clp clp cgl osi coinutils 
#Libs: -L${libdir} -lOsiCbc -L/d/a/cbcbox/cbcbox/cbc_dist/lib -lCgl -lOsiClp -lClp -lOsi -lCoinUtils      
#Requires: cbc osi-clp clp cgl osi coinutils 
